{
  "name": "agent-personal-memory-workspace",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Shared core and separate Pi and Claude Code packages",
  "license": "MIT",
  "author": "Brin (https://github.com/bin-Deng-666)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bin-Deng-666/agent-personal-memory.git"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./packages/pi/index.ts"
    ]
  },
  "scripts": {
    "build": "npm run build:pi && npm run build:claude",
    "build:pi": "node scripts/build-pi.mjs",
    "build:claude": "node scripts/build-claude.mjs",
    "check:bundles": "node scripts/build-pi.mjs --check && node scripts/build-claude.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -p tsconfig.json",
    "check:structure": "node scripts/check-structure.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run format:check && npm run check && npm run check:structure && npm run check:bundles && npm test && npm run check:package"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.19.19",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}

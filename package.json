{
  "name": "agent-personal-memory",
  "version": "0.4.1",
  "type": "module",
  "description": "Personal memory for Pi: meaningful context, quiet capture, evidence-based extraction and relevant advice",
  "license": "MIT",
  "author": "Brin (https://github.com/bin-Deng-666)",
  "homepage": "https://github.com/bin-Deng-666/agent-personal-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bin-Deng-666/agent-personal-memory.git"
  },
  "bugs": {
    "url": "https://github.com/bin-Deng-666/agent-personal-memory/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "personal-memory",
    "terminal"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -p tsconfig.json",
    "check:structure": "node scripts/check-structure.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run format:check && npm run check && npm run check:structure && npm test && npm run check:package"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "22.19.19",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
